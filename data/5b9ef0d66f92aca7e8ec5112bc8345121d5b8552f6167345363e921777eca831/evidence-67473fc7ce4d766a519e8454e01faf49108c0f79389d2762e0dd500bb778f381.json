},"ev-ca90b22eb151373f0c096f3f764c8dc868d51767347fa3d561f88566946e54fe":{"locator":"page 8","quote":"65. Rebo N.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-d0cb8b880993b471f8d83dfaa32dc9b3628a2c34b2993f4075558669c4d8f6d5":{"locator":"page 8","quote":"51. Merlot N.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-d0e5182c4751d5ee08300db516a449655e0ec9b81d007a045fb1772428de72c4":{"locator":"grape-article annex applicability","quote":"Articolo 2\n(Base ampelografica)\n2.1 I vini ad indicazione geografica tipica \"Alta Valle della Greve\", bianchi, rossi e rosati devono\nessere ottenuti da uve provenienti da vigneti composti, nell'ambito aziendale, da uno o piu' vitigni\na bacca bianca o rossa, idonei alla coltivazione nell’ambito della Regione Toscana.\n\n2.2 L’indicazione geografica tipica “Alta Valle della Greve” con il riferimento al nome di un\nvitigno è riservata ai vini ottenuti da vigneti composti in ambito aziendale per almeno l’85% dal\nvitigno corrispondente. Possono concorrere alla produzione di detti vini le uve dei vitigni idonei alla\ncoltivazione nell’ambito della Regione Toscana fino ad un massimo del 15%.\n2.3 Il riferimento al nome di due vitigni nella designazione e presentazione dei vini ad indicazione\ngeografica tipica “Alta Valle della Greve” è consentita alla condizione che il vino derivi\nesclusivamente da uve prodotte dai due vitigni ai quali si può fare riferimento e il quantitativo di\nuva prodotto da uno dei due vitigni sia comunque superiore al 15% del totale.\n2.4. Si riportano nell'allegato 1 i vitigni che possono concorrere alla produzione dei vini sopra\nindicati, iscritti nel Registro nazionale delle varietà di vite per uve da vino approvato con D.M. 7\nmaggio 2004 (pubblicato sulla G.U. n. 242 del 14 ottobre 2004), e successivi aggiornamenti.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-d548249073418e13fb3202ccb80800b5da4221a9682c75dc0cd7a2f89aa74163":{"locator":"page 7","quote":"35. Groppello di Santo Stefano N.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-dce477a632a5402eb8353b08548651ff50fdf0a153f7fe5cbcc33e0923e74eda":{"locator":"page 7","quote":"48. Manzoni Bianco B.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-df493f520d67f45c3a8f54e74ddc77df9a32ad8ea1726312cd3db3c32af58fdb":{"locator":"page 7","quote":"8. Ansonica B.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-e305104469af0179742b49b55438de652f29b7e632d649a0a8af0cb9bf029401":{"locator":"page 7","quote":"13. Bracciola Nera N.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-e750976d7928f754ebcec09a25b532f1b8c5431146193a8b675a181bd2d0aafb":{"locator":"page 8","quote":"75. Semillon B.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-e7aef0804bb3752dbe223aa0f8c592dde476eadf56d5fc805ca8a30cf62a4b56":{"locator":"page 8","quote":"87. Viogner B.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-eefa97d036120abbe8784088e9ea6b73df1418c8090bf47aec37f8675ba8c784":{"locator":"page 7","quote":"Allegato 1 - Vitigni idonei alla produzione del vino ad indicazione geografica tipica ALTA\nVALLE DELLA GREVE","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-efb0aaf19d8eb52aac63d821436c16ed07e3a95f5fba335be1b4ab6deae425a5":{"locator":"page 7","quote":"47. Mammolo N.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-f37ae72da7dccf8d5795f13746241b65e4e2f90ab68d9d3a7d11856b0081269d":{"locator":"page 8","quote":"49. Marsanne B.","sourceId":"source-dc75178dba67314ccb191742aa121c11d213368bc9faf41b557549eebe0faedb"},"ev-f60d33aed9b7a28e65d68d68349c742f4a8d7c2e53c1150df7365a7d814505bd":{"locato