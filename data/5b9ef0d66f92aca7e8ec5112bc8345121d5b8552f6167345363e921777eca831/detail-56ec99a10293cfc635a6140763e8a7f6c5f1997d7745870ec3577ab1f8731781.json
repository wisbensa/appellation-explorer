{"appellations":[{"countryId":"IT","currentness":{"documentRelations":[{"actDate":"2026-03-27","actScope":{"end":37374,"heading":"\nDECRETO 27 marzo 2026 .\nApprovazione di una modifica ordinaria al disciplinare di\nproduzione della denominazione di origine controllata dei\nvini «Lessona».","start":190},"approvalState":"approved","documentSourceId":"source-f6d59f5a5658de01b1406c262d683b2bbc75a23fd1d69513e62b2084b7437a15","entityId":"PDO-IT-A1191","evidence":[{"$evidence":"ev-dd1aa3107d4f0daa5e8a1618a04df7765e37462737a646fd31bfc7680400261a"},{"$evidence":"ev-d65e9177d6ed9e4c7ccbe2960f4b8650079c9cbd4b3915f9f4dfeb8b2e76e64e"},{"$evidence":"ev-f3539aa1735c88d72a74bf0eed19546ec06636926726ea1d360ad8f187585add"}],"pageSourceId":"source-c72bfff1f4527f19a7ce64b20e4f3978e197d654cd584ac866c3d68d574b99b2","pageUrl":"https://www.masaf.gov.it/flex/cm/pages/ServeBLOB.php/L/IT/IDPagina/23951","relation":"attachment","roles":["specification","legal-act"]},{"actDate":"2026-03-27","evidence":[{"$evidence":"ev-e01b9c7d11914e455fd88b666e1b38241c358f07f971e0cf49b1ed04e24cfa06"}],"fromSourceId":"source-f6d59f5a5658de01b1406c262d683b2bbc75a23fd1d69513e62b2084b7437a15","relation":"approves_attachment","target":{"annex":"A","end":31476,"entityId":"PDO-IT-A1191","role":"specification","start":19651},"toSourceId":"source-f6d59f5a5658de01b1406c262d683b2bbc75a23fd1d69513e62b2084b7437a15"},{"effectiveFrom":"2026-04-04","evidence":[{"$evidence":"ev-8540e8cc2e38d0e375763459d9ebcecbfb95e3abf7495f0d96732208b202e6cd"},{"$evidence":"ev-df072ede580e1338ebbf01d581314ce90710890bbd69ec5372d8894c3deb4a3d"},{"$evidence":"ev-df072ede580e1338ebbf01d581314ce90710890bbd69ec5372d8894c3deb4a3d"},{"$evidence":"ev-df072ede580e1338ebbf01d581314ce90710890bbd69ec5372d8894c3deb4a3d"},{"$evidence":"ev-df072ede580e1338ebbf01d581314ce90710890bbd69ec5372d8894c3deb4a3d"},{"$evidence":"ev-df072ede580e1338ebbf01d581314ce90710890bbd69ec5372d8894c3deb4a3d"},{"$evidence":"ev-df072ede580e1338ebbf01d581314ce90710890bbd69ec5372d8894