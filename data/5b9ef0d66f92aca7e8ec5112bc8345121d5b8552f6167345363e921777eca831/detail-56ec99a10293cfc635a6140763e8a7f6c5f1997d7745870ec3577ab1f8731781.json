ource-f6d59f5a5658de01b1406c262d683b2bbc75a23fd1d69513e62b2084b7437a15","publication":{"date":"2026-10-13","uri":"http://data.europa.eu/eli/C/2026/5265/oj"},"sourceId":"source-efeb20aae29ab25356bd72e86cc38d7a29c2f92509dd841a7b0f6b85e126ffb8","specificationPageUrl":"https://www.masaf.gov.it/flex/cm/pages/ServeBLOB.php/L/IT/IDPagina/24186","state":"confirmed"},"state":"confirmed"}},"sourceIds":["source-f6d59f5a5658de01b1406c262d683b2bbc75a23fd1d69513e62b2084b7437a15"],"traditionalTerms":["DOC"],"wines":[{"ageing":{"evidence":[],"state":"not_found"},"alcohol":{"evidence":[],"state":"unverified"},"applicability":{"color":"rosso","evidence":[{"$evidence":"ev-5968e1f5fa2736664c2cb1bb504db5580d4c04d4b3610ad2070e62e8ef82251c"}],"methods":[],"qualifiers":[]},"area":{"evidence":[{"$evidence":"ev-35e90c72060f5265270c84f8b799755b15c08b218ec22d6ddc8fd6b5c365ffb5"}],"original":"Articolo 3\nZona di produzione delle uve\n1. La zona di produzione delle uve destinate a produrre i vini a\ndenominazione di origine controllata «Lessona» comprende l’intero ter-\nritorio del Comune di Lessona.","state":"confirmed"},"evidence":[{"$evidence":"ev-5968e1f5fa2736664c2cb1bb504db5580d4c04d4b3610ad2070e62e8ef82251c"}],"grapeRule":{"basis":"mixed","complete":true,"constraints":[{"basis":"vineyard","evidence":[{"$evidence":"ev-7d6674f61e19c8b2dce977399157cde751151f7cf17c5d4f953493af054b33f0"}],"grapeIds":["grape-d4d5003b13814a84eb17"],"max":100,"min":85},{"basis":"grapes","evidence":[{"$evidence":"ev-1486f8176049703e4146cb62dd2e704eadb3ac32a8438073ca0bf7ca881f5e61"}],"grapeIds":["grape-6c58b86d7ac6b8bb736e","grape-93e3b24136016aa47a11"],"max":15}],"evidence":[{"$evidence":"ev-ac10d593cb311aaf6c4de10870475590aa2071e88a177dd0cdc6475c49e4ef97"},{"$evidence":"ev-1400a9de9fe16c73e78d32785ac3ee5ca7b0eee90caf1f1e4c40288d64c40315"},{"$evidence":"ev-ac10d593cb311aaf6c4de10870475590aa2071e88a177dd0cdc6475c49e4ef97"}],"grapeIds":["grape-d4d5003b13814a84eb17","grape-6c58b86d7ac6b8bb736e","grape-93e3b24136016aa47a11"],"original":"Articolo 2\nBase ampelografica dei vigneti\n1. I vini a denominazione di origine controllata «Lessona» devono\nessere ottenuti dalle uve provenienti dai vigneti, aventi in ambito azien-\ndale, la seguente composizione ampelografica:\nNebbiolo (Spanna) dall’85% al 100%.\nPossono concorrere, singolarmente o congiuntamente, le uve pro-\nvenienti dai vitigni Vespolina e Uva Rara fino ad un massimo del 15%."},"id":"wine-73f71e8eb69e91ef7b40","name":{"original":"Lessona"},"production":{"evidence":[{"$evidence":"ev-23ad6ab8e86347018c938fac7f85d6e6c74ca175cc2b4a24c4d430090a341453"}],"original":"Articolo 4\nNorme per la viticoltura, rese\ne caratteristiche qualitative delle uve\n1. Le condizioni ambientali e di coltura dei vigneti destinati alla\nproduzione dei vini «Lessona» debbono essere quelle tradizionali della\nzona e, comunque, atte a conferire alle uve ed ai vini derivati le loro\ndeterminate e specifiche caratteristiche di qualità.\n2. In particolare le condizioni di coltura dei vigneti devono rispon-\ndere ai requisiti esposti ai punti che seguono:\nterreni: sabbiosi, limosi, argillosi e loro eventuali combinazioni;\ngiacitura: collinare. Sono da escludere i terreni di fondovalle,\numidi, non sufficientemente soleggiati;\naltitudine: non inferiore a metri 200 s.l.m. e non superiore a me-\ntri 500 s.l.m.;\nesposizione: adatta ad assicurare un’idonea maturazione delle\nuve;\ndensità d’impianto: quelle generalmente usate in funzione delle\ncaratteristiche peculiari delle uve e del vino. I vigneti oggetto di nuova\niscrizione o di reimpianto dovranno essere composti da un numero di\nceppi ad ettaro, calcolati sul sesto d’impianto, non inferiore a 3.000;\nforme di allevamento e sistemi di potatura: devono essere quelli\ngeneralmente usati e comunque atti a non modificare le caratteristiche\ndelle uve e dei vini;\nè vietata ogni pratica di forzatura.\n3. La resa massima di uva ad ettaro di vigneto in coltura specializ-\nzata per la produzione dei vini di cui all’art. 1 ed i titoli alcolometrici\nvolumici minimi naturali delle relative uve destinate alla vinificazione\ndevono essere rispettivamente le seguenti:\nResa Titolo alcolometrico volumico natu-\nVini\nuva t/ha rale minimo\n«Lessona» 8,00 12,00% vol\n«Lessona»\n7,20 12,00% vol\nriserva\nIl vino a denominazione di origine controllata «Lessona» nelle sue\ntipologie, può essere accompagnato dalla menzione «vigna», seguita dal\nrelativo toponimo o nome tradizionale, purché il relativo vigneto abbia\nun’età d’impianto di almeno tre anni.\nLe rese massime di uva ad ettaro di vigneto in coltura specializza-\nta per la produzione del vino «Lessona» nelle sue tipologie, ed i titoli\nalcolometrici volumici minimi naturali delle relative uve destinate alla\nvinificazione devono essere i seguenti:\nTitolo alcolometrico\nVini Resa uva t/ha volumico naturale\nminimo\n8,00 dal\n«Lessona» e «Lessona»\n3° anno 12,00% vol.\nvigna\nd’impianto\n7,20 dal\n«Lessona» riserva e\n7° anno 12,00% vol.\n«Lessona» riserva vigna\nd’impianto\nNelle annate favorevoli, i quantitativi di uva ottenuti e da destinare\nalla produzione dei vini a denominazione di origine controllata «Lesso-\nna» devono essere riportati nei limiti di cui sopra purché la produzione\nglobale non superi del 20% il limite medesimo, fermo restando il limite\nresa uva/vino per i quantitativi di cui trattasi.","state":"confirmed"},"qualifiers":[],"sensory":{"evidence":[],"state":"unverified"},"type":"rosso"},{"ageing":{"evidence":[],"state":"not_found"},"alcohol":{"evidence":[],"state":"unverified"},"applicability":{"color":"rosso","evidence":[{"$evidence":"ev-0a3618a3ff31eb8526fb9c08eda5515bb065aff92e30158c8a7d4fa444fbd88b"}],"methods":[],"qualifiers":["riserva"]},"area":{"evidence":[{"$evidence":"ev-35e90c72060f5265270c84f8b799755b15c08b218ec22d6ddc8fd6b5c365ffb5"}],"original":"Articolo 3\nZona di produzione delle uve\n1. La zona di produzione delle uve destinate a produrre i vini a\ndenominazione di origine controllata «Lessona» comprende l’intero ter-\nritorio del Comune di Lessona.","state":"confirmed"},"evidence":[{"$evidence":"ev-0a3618a3ff31eb8526fb9c08eda5515bb065aff92e30158c8a7d4fa444fbd88b"}],"grapeRule":{"basis":"mixed","complete":true,"constraints":[{"basis":"vineyard","evidence":[{"$evidence":"ev-7d6674f61e19c8b2dce977399157cde751151f7cf17c5d4f953493af054b33f0"}],"grapeIds":["grape-d4d5003b13814a84eb17"],"max":100,"min":85},{"basis":"grapes","evidence":[{"$evidence":"ev-1486f8176049703e4146cb62dd2e704eadb3ac32a8438073ca0bf7ca881f5e61"}],"grapeIds":["grape-6c58b86d7ac6b8bb736e","grape-93e3b24136016aa47a11"],"max":15}],"evidence":[{"$evidence":"ev-ac10d593cb311aaf6c4de10870475590aa2071e88a177dd0cdc6475c49e4ef97"},{"$evidence":"ev-1400a9de9fe16c73e78d32785ac3ee5ca7b0eee90caf1f1e4c40288d64c40315"},{"$evidence":"ev-ac10d593cb311aaf6c4de10870475590aa2071e88a177dd0cdc6475c49e4ef97"}],"grapeIds":["grape-d4d5003b13814a84eb17","grape-6c58b86d7ac6b8bb736e","grape-93e3b24136016aa47a11"],"original":"Articolo 2\nBase ampelografica dei vigneti\n1. I vini a denominazione di origine controllata «Lessona» devono\nessere ottenuti dalle uve provenienti dai vigneti, aventi in ambito azien-\ndale, la seguente composizione ampelografica:\nNebbiolo (Spanna) dall’85% al 100%.\nPossono concorrere, singolarmente o congiuntamente, le uve pro-\nvenienti dai vitigni Vespolina e Uva Rara fino ad un massimo del 15%."},"id":"wine-a65e73991e1302056108","name":{"original":"Lessona riserva"},"production":{"evidence":[{"$evidence":"ev-23ad6ab8e86347018c938fac7f85d6e6c74ca175cc2b4a24c4d430090a341453"}],"original":"Articolo 4\nNorme per la viticoltura, rese\ne caratteristiche qualitative delle uve\n1. Le condizioni ambientali e di coltura dei vigneti destinati alla\nproduzione dei vini «Lessona» debbono essere quelle tradizionali della\nzona e, comunque, atte a conferire alle uve ed ai vini derivati le loro\ndeterminate e specifiche caratteristiche di qualità.\n2. In particolare le condizioni di coltura dei vigneti devono rispon-\ndere ai requisiti esposti ai punti che seguono:\nterreni: sabbiosi, limosi, argillosi e loro eventuali combinazioni;\ngiacitura: collinare. Sono da escludere i terreni di fondovalle,\numidi, non sufficientemente soleggiati;\naltitudine: non inferiore a metri 200 s.l.m. e non superiore a me-\ntri 500 s.l.m.;\nesposizione: adatta ad assicurare un’idonea maturazione delle\nuve;\ndensità d’impianto: quelle generalmente usate in funzione delle\ncaratteristiche peculiari delle uve e del vino. I vigneti oggetto di nuova\niscrizione o di reimpianto dovranno essere composti da un numero di\nceppi ad ettaro, calcolati sul sesto d’impianto, non inferiore a 3.000;\nforme di allevamento e sistemi di potatura: devono essere quelli\ngeneralmente usati e comunque atti a non modificare le caratteristiche\ndelle uve e dei vini;\nè vietata ogni pratica di forzatura.\n3. La resa massima di uva ad ettaro di vigneto in coltura specializ-\nzata per la produzione dei vini di cui all’art. 1 ed i titoli alcolometrici\nvolumici minimi naturali delle relative uve destinate alla vinificazione\ndevono essere rispettivamente le seguenti:\nResa Titolo alcolometrico volumico natu-\nVini\nuva t/ha rale minimo\n«Lessona» 8,00 12,00% vol\n«Lessona»\n7,20 12,00% vol\nriserva\nIl vino a denominazione di origine controllata «Lessona» nelle sue\ntipologie, può essere accompagnato dalla menzione «vigna», seguita dal\nrelativo toponimo o nome tradizionale, purché il relativo vigneto abbia\nun’età d’impianto di almeno tre anni.\nLe rese massime di uva ad ettaro di vigneto in coltura specializza-\nta per la produzione del vino «Lessona» nelle sue tipologie, ed i titoli\nalcolometrici volumici minimi naturali delle relative uve destinate alla\nvinificazione devono essere i seguenti:\nTitolo alcolometrico\nVini Resa uva t/ha volumico naturale\nminimo\n8,00 dal\n«Lessona» e «Lessona»\n3° anno 12,00% vol.\nvigna\nd’impianto\n7,20 dal\n«Lessona» riserva e\n7° anno 12,00% vol.\n«Lessona» riserva vigna\nd’impianto\nNelle annate favorevoli, i quantitativi di uva ottenuti e da destinare\nalla produzione dei vini a denominazione di origine controllata «Lesso-\nna» devono essere riportati nei limiti di cui sopra purché la produzione\nglobale non superi del 20% il limite medesimo, fermo restando il limite\nresa uva/vino per i quantitativi di cui trattasi.","state":"confirmed"},"qualifiers":["riserva"],"sensory":{"evidence":[],"state":"unverified"},"type":"rosso"}]}],"designations":[],"sources":[{"agency":"European Commission","finalUrl":"https://ec.europa.eu/geographical-indications-register/eambrosia-public-api/api/gi-applications/filter","finalUrlState":"recorded","id":"4bdcbc7bec27c880a4da55de3c2841fb35dba339da7aab160bb2f32bce7d13ad","kind":"register","retrievedAt":"2026-10-18T01:16:23.990Z","sha256":"4bdcbc7bec27c880a4da55de3c2841fb35dba339da7aab160bb2f32bce7d13ad","title":"eAmbrosia geographical indications register","url":"https://ec.europa.eu/geographical-indications-register/eambrosia-public-api/api/gi-applications/filter","verifiedAt":"2026-10-18T01:16:23.990Z"},{"agency":"European Commission","finalUrl":"https://ec.europa.eu/geographical-indications-register/eambrosia-public-api/api/gi-applications/id/6404?lang=en","finalUrlState":"recorded","id":"53b845c8ae6913fbab5cb68894d1d29a648d6f6452fed2947f615c48cee9a141","kind":"register","retrievedAt":"2026-10-18T01:24:39.476Z","sha256":"53b845c8ae6913fbab5cb68894d1d29a648d6f6452fed2947f615c48cee9a141","title":"eAmbrosia application: Lessona (PDO-IT-A1191)","url":"https://ec.europa.eu/geographical-indications-register/eambrosia-public-api/api/gi-applications/id/6404?lang=en","verifiedAt":"2026-10-18T01:24:39.476Z"},{"agency":"MASAF","gi":"PDO","id":"source-6a9ad3c95f6cc668e74aefdacc14aa822a2ea274c386d13852a2ca78ac0cbf4f","kind":"catalogue","retrievedAt":"2026-10-18T01:16:14.850Z","sha256":"6a9ad3c95f6cc668e74aefdacc14aa822a2ea274c386d13852a2ca78ac0cbf4f","title":"Elenco alfabetico Vini DOP (478.57 KB)