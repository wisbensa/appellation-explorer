007fcc84bc611f0580981fbbf1c45371f915eebf7294"},{"$evidence":"ev-9f63e49fb5d1245e79d6eb171ba1364d567caaf812f02eceb797f27b9c05b069"},{"$evidence":"ev-3933be6676af98eb199a36b6c3154e79e9ad601f395178665c61f6674d58811c"}],"national":{"campaign":{"evidence":[{"$evidence":"ev-a2f9a5828ac42de3bd15007fcc84bc611f0580981fbbf1c45371f915eebf7294"}],"from":{"endYear":2026,"startYear":2025},"kind":"wine_campaign_from","state":"confirmed"},"commencement":{"effectiveFrom":"2025-08-13","evidence":[{"$evidence":"ev-a2f9a5828ac42de3bd15007fcc84bc611f0580981fbbf1c45371f915eebf7294"},{"$evidence":"ev-3933be6676af98eb199a36b6c3154e79e9ad601f395178665c61f6674d58811c"}],"state":"confirmed"},"jurisdiction":"IT"},"profile":"it-national-approved-specification-v1","referenceDate":"2026-10-18","sourceId":"source-fecc281635f568d94cba00bd5e7ab74ba78409fdb41dab0b5e3879d097fd3521","specification":{"annex":"A","end":28861,"start":19631,"textSha256":"9311fc5d1ac1545f471cf3774b3ecafefa57be01019d895d2464e93d07872cab"},"union":{"condition":"commission_publication_of_approved_amendment_and_single_document_in_oj_c","effectiveFrom":null,"evidence":[{"$evidence":"ev-9f63e49fb5d1245e79d6eb171ba1364d567caaf812f02eceb797f27b9c05b069"}],"jurisdiction":"EU","state":"unverified"}},"sourceIds":["source-fecc281635f568d94cba00bd5e7ab74ba78409fdb41dab0b5e3879d097fd3521"],"traditionalTerms":["DOC"],"wines":[{"ageing":{"evidence":[],"state":"not_found"},"alcohol":{"evidence":[],"state":"unverified"},"applicability":{"color":"rosso","evidence":[{"$evidence":"ev-0a8467dc1dcd4fb4478b31087523ca8b225004bb051ba382fd2a54e1d24a2cb4"}],"methods":[],"qualifiers":[]},"area":{"evidence":[{"$evidence":"ev-559199aa3bd16ac4975e7f27c4c815a771ecbd159f29e9c42b19ecfeae5efa92"}],"original":"Art. 3.\nZona di produzione delle uve\nLa zona di produzione del vino a DOC «Gabiano» comprende i\nterritori collinari idonei alla coltura della vite nei Comuni di Gabiano e\nMoncestino in Provincia di Alessandria.","state":"confirmed"},"evidence":[{"$evidence":"ev-0a8467dc1dcd4fb4478b31087523ca8b225004bb051ba382fd2a54e1d24a2cb4"}],"grapeRule":{"basis":"vineyard","complete":true,"constraints":[{"basis":"vineyard","evidence":[{"$evidence":"ev-682f4d81376a524b343bf91d3edd5b88abfca9efed275353d38d799ccd44677f"}],"grapeIds":["grape-e3ad8b2a398a36dd4428"],"max":95,"min":90},{"basis":"vineyard","evidence":[{"$evidence":"ev-b1ea6dbe31adb4654ac79a4e18b6ee2dffb385b472231f69959fda0be875069c"}],"grapeIds":["grape-7b94293a7417b3385d3b","grape-b5d9f7e15636ec432963","grape-d4d5003b13814a84eb17","grape-6cfbd56c3aef4081125b"],"max":10,"min":5}],"evidence":[{"$evidence":"ev-dae00ab97b165e6957f2c0b449f8873271cf582baf9b86e694a5cbd5836015f4"}],"grapeIds":["grape-e3ad8b2a398a36dd4428","grape-7b94293a7417b3385d3b","grape-b5d9f7e15636ec432963","grape-d4d5003b13814a84eb17","grape-6cfbd56c3aef4081125b"],"original":"Art. 2.\nBase ampelografia\nLa DOC «Gabiano» è riservata al vino rosso ottenuto dalle uve\nprovenienti da vigneti aventi in ambito aziendale la seguente composi-\nzione ampelografica:\nBarbera dal 90 al 95%;\nFreisa N. e/o Grignolino N. e/o Nebbiolo N. e/o Dolcetto N. da\nsoli o congiuntamente dal 5% fino ad un massimo del 10%."},"id":"wine-aaf845a1096b40f6ab05","name":{"original":"Gabiano"},"production":{"evidence":[{"$evidence":"ev-e9adffdb56ab74c178998b2bcfa69e41feb62c38b6e18a1633deaf9e45556df7"}],"original":"Art. 4.\nNorme per la viticoltura\nLe condizioni ambientali e di coltura dei vigneti destinati alla pro-\nduzione del vino a DOC «Gabiano» di cui all’art. 2, devono essere quel-\nle tradizionali della zona di produzione e comunque atti a conferire alle\nuve e al vino derivato le specifiche caratteristiche di qualità.\nSono pertanto da considerarsi idonei al fine dell’iscrizione allo\nschedario viticolo della denominazione di origine unicamente i vigneti\ndi giacitura collinare ed esposizione adatta, i cui terreni siano di natura\nargillosa-calcarea o calcarea argillosa.\nSono esclusi i terreni di fondovalle, pianeggianti, umidi e non suf-\nficientemente soleggiati:\ndensità d’impianto: quelle generalmente usate in funzione del-\nle caratteristiche peculiari delle uve e del vino. I nuovi impianti ed i\nreimpianti dal momento dell’entrata in vigore del presente disciplinare\ndovranno avere un numero di ceppi per ettaro non inferiore a 4.000;\nforme di allevamento: controspalliera con vegetazione\nassurgente;\nsistemi di potatura:: il Guyot tradizionale, il Cordone speronato\nbasso e/o altre forme comunque atte a non modificare in negativo la\nqualità delle uve.\nÈ vietata ogni pratica di forzatura.\nÈ consentita l’irrigazione di soccorso.\nLa resa massima di uva ad ettaro di vigneto in coltura specializ-\nzata per la produzione dei vini di cui all’art. 1 ed i titoli alcolometrici\nvolumici naturali minimi delle relative uve destinate alla vinificazione,\ndevono essere rispettivamente le seguenti:\nTitolo alcolometrico volumico\nTipologie Resa uva t/ha\nnaturale minimo % vol.\nGabiano 8 12%\nGabiano\n8 12,5%\nRiserva\nA tale limite di resa uva/ha, anche in annate eccezionalmente fa-\nvorevoli, la produzione dovrà essere riportata attraverso un’accurata\ncernita delle uve, purché la produzione globale non superi del 20% il\nlimite medesimo.","state":"confirmed"},"qualifiers":[],"sensory":{"evidence":[],"state":"unverified"},"type":"rosso"},{"ageing":{"evidence":[],"state":"not_found"},"alcohol":{"evidence":[],"state":"unverified"},"applicability":{"color":"rosso","evidence":[{"$evidence":"ev-c194a1c889557384c5e53ff26b09eb0e0f316f61df87d25399140617332cd78a"}],"methods":[],"qualifiers":["Riserva"]},"area":{"evidence":[{"$evidence":"ev-559199aa3bd16ac4975e7f27c4c815a771ecbd159f29e9c42b19ecfeae5efa92"}],"original":"Art. 3.\nZona di produzione delle uve\nLa zona di produzione del vino a DOC «Gabiano» comprende i\nterritori collinari idonei alla coltura della vite nei Comuni di Gabiano e\nMoncestino in Provincia di Alessandria.","state":"confirmed"},"evidence":[{"$evidence":"ev-c194a1c889557384c5e53ff26b09eb0e0f316f61df87d25399140617332cd78a"}],"grapeRule":{"basis":"vineyard","complete":true,"constraints":[{"basis":"vineyard","evidence":[{"$evidence":"ev-682f4d81376a524b343bf91d3edd5b88abfca9efed275353d38d799ccd44677f"}],"grapeIds":["grape-e3ad8b2a398a36dd4428"],"max":95,"min":90},{"basis":"vineyard","evidence":[{"$evidence":"ev-b1ea6dbe31adb4654ac79a4e18b6ee2dffb385b472231f69959fda0be875069c"}],"grapeIds":["grape-7b94293a7417b3385d3b","grape-b5d9f7e15636ec432963","grape-d4d5003b13814a84eb17","grape-6cfbd56c3aef4081125b"],"max":10,"min":5}],"evidence":[{"$evidence":"ev-dae00ab97b165e6957f2c0b449f8873271cf582baf9b86e694a5cbd5836015f4"}],"grapeIds":["grape-e3ad8b2a398a36dd4428","grape-7b94293a7417b3385d3b","grape-b5d9f7e15636ec432963","grape-d4d5003b13814a84eb17","grape-6cfbd56c3aef4081125b"],"original":"Art. 2.\nBase ampelografia\nLa DOC «Gabiano» è riservata al vino rosso ottenuto dalle uve\nprovenienti da vigneti aventi in ambito aziendale la seguente composi-\nzione ampelografica:\nBarbera dal 90 al 95%;\nFreisa N. e/o Grignolino N. e/o Nebbiolo N. e/o Dolcetto N. da\nsoli o congiuntamente dal 5% fino ad un massimo del 10%."},"id":"wine-b666624bfed131c8b2b8","name":{"original":"Gabiano Riserva"},"production":{"evidence":[{"$evidence":"ev-e9adffdb56ab74c178998b2bcfa69e41feb62c38b6e18a1633deaf9e45556df7"}],"original":"Art. 4.\nNorme per la viticoltura\nLe condizioni ambientali e di coltura dei vigneti destinati alla pro-\nduzione del vino a DOC «Gabiano» di cui all’art. 2, devono essere quel-\nle tradizionali della zona di produzione e comunque atti a conferire alle\nuve e al vino derivato le specifiche caratteristiche di qualità.\nSono pertanto da considerarsi idonei al fine dell’iscrizione allo\nschedario viticolo della denominazione di origine unicamente i vigneti\ndi giacitura collinare ed esposizione adatta, i cui terreni siano di natura\nargillosa-calcarea o calcarea argillosa.\nSono esclusi i terreni di fondovalle, pianeggianti, umidi e non suf-\nficientemente soleggiati:\ndensità d’impianto: quelle generalmente usate in funzione del-\nle caratteristiche peculiari delle uve e del vino. I nuovi impianti ed i\nreimpianti dal momento dell’entrata in vigore del presente disciplinare\ndovranno avere un numero di ceppi per ettaro non inferiore a 4.000;\nforme di allevamento: controspalliera con vegetazione\nassurgente;\nsistemi di potatura:: il Guyot tradizionale, il Cordone speronato\nbasso e/o altre forme comunque atte a non modificare in negativo la\nqualità delle uve.\nÈ vietata ogni pratica di forzatura.\nÈ consentita l’irrigazione di soccorso.\nLa resa massima di uva ad ettaro di vigneto in coltura specializ-\nzata per la produzione dei vini di cui all’art. 1 ed i titoli alcolometrici\nvolumici naturali minimi delle relative uve destinate alla vinificazione,\ndevono essere rispettivamente le seguenti:\nTitolo alcolometrico volumico\nTipologie Resa uva t/ha\nnaturale minimo % vol.\nGabiano 8 12%\nGabiano\n8 12,5%\nRiserva\nA tale limite di resa uva/ha, anche in annate eccezionalmente fa-\nvorevoli, la produzione dovrà essere riportata attraverso un’accurata\ncernita delle uve, purché la produzione globale non superi del 20% il\nlimite medesimo.","state":"confirmed"},"qualifiers":["Riserva"],"sensory":{"evidence":[],"state":"unverified"},"type":"rosso"}]}],"designations":[],"sources":[{"agency":"European Commission","finalUrl":"https://ec.europa.eu/geographical-indications-register/eambrosia-public-api/api/gi-applications/filter","finalUrlState":"recorded","id":"4bdcbc7bec27c880a4da55de3c2841fb35dba339da7aab160bb2f32bce7d13ad","kind":"register","retrievedAt":"2026-10-18T01:16:23.990Z","sha256":"4bdcbc7bec27c880a4da55de3c2841fb35dba339da7aab160bb2f32bce7d13ad","title":"eAmbrosia geographical indications register","url":"https://ec.europa.eu/geographical-indications-register/eambrosia-public-api/api/gi-applications/filter","verifiedAt":"2026-10-18T01:16:23.990Z"},{"agency":"European Commission","finalUrl":"http